# Local Properties Template for Android Studio / Gradle Build
# Copy this file to 'local.properties' in the root directory.
# Set the path to your local Android SDK installation.

# On macOS:
# sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

# On Linux:
# sdk.dir=/home/YOUR_USERNAME/Android/Sdk

# On Windows:
# sdk.dir=C\:\\Users\\YOUR_USERNAME\\AppData\\Local\\Android\\Sdk
